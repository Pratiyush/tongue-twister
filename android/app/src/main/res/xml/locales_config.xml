<?xml version="1.0" encoding="utf-8"?>
<!-- The app's 40 UI languages for Android 13+'s per-app language setting
     (Settings > Apps > Tongue Twisters > Language). One entry per row of
     lib/l10n/languages.dart, kept in step by test/platform_languages_test.dart.
     Hebrew and Indonesian use Android's legacy codes iw and in; Flutter reads
     them as he and id. A pick here applies while the in-app choice is
     System default. -->
